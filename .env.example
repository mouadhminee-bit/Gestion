# NEXORA — exemple de configuration (aucun secret réel ici)
# Copier vers .env.local puis adapter.

# Backend de données (lu par src/data/backend.ts) :
#   "local"    : IndexedDB, aucun compte requis — défaut (variable absente ou vide) ;
#   "supabase" : configuration Cloud lue et validée ; le cloud n'est pas encore activé dans
#                cette version, l'application reste en mode local ;
#   autre valeur : refusée, mode local.
VITE_DATA_BACKEND=local

# Paramètres Supabase : URL racine du projet (https) et clé PUBLIQUE uniquement (JWT "anon"
# ou "sb_publishable_…"). Une clé service_role ou sb_secret_… est refusée — JAMAIS dans le frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Extension IA (facultative) : l'appel doit passer par un proxy serveur qui détient la clé.
# Ne jamais placer de clé API de modèle dans une variable VITE_* (elles sont exposées au navigateur).
VITE_ASSISTANT_PROXY_URL=
