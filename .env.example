# NEXORA — exemple de configuration (aucun secret réel ici)
# Copier vers .env.local puis adapter.

# Backend de données : "local" (IndexedDB, par défaut, aucun compte requis)
# ou "supabase" (architecture préparée, voir docs/ARCHITECTURE.md — non activée dans cette version).
VITE_DATA_BACKEND=local

# Paramètres Supabase (uniquement la clé publique "anon" — JAMAIS la clé service_role dans le frontend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Extension IA (facultative) : l'appel doit passer par un proxy serveur qui détient la clé.
# Ne jamais placer de clé API de modèle dans une variable VITE_* (elles sont exposées au navigateur).
VITE_ASSISTANT_PROXY_URL=
